# EduGuide environment template.
# Copy to .env and fill in values. Do not commit .env.

# === API Keys ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/eduguide
REDIS_URL=redis://localhost:6379/0

# === Vector Store ===
CHROMA_HOST=localhost
CHROMA_PORT=8001

# === Application ===
APP_ENV=development
LOG_LEVEL=DEBUG
SECRET_KEY=change-me

# === External APIs ===
GITHUB_TOKEN=
